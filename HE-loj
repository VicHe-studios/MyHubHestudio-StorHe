<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --accent: #2563eb;
    --accent-soft: rgba(37, 99, 235, 0.15);
    --text: #0b1220;
    --muted: #64748b;
    --line: rgba(15, 23, 42, 0.08);
    --card: #ffffff;
    --field: #f6f8fb;
  }
  
  html[data-modo="oscuro"] {
    --text: #f4f4f6;
    --muted: #9ea1aa;
    --line: rgba(255, 255, 255, 0.09);
    --card: #222227;
    --field: #2a2a31;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; height: 100vh; display: flex; flex-direction: column;
    font-family: 'Segoe UI Variable', system-ui, sans-serif;
    background: var(--card); color: var(--text);
    overflow: hidden;
  }

  /* Pestañas */
  .tabs {
    display: flex; border-bottom: 1px solid var(--line); background: var(--card); flex-shrink: 0;
  }
  .tab {
    flex: 1; padding: 12px 0; text-align: center; font-size: 13px; font-weight: 600;
    color: var(--muted); cursor: pointer; transition: 0.2s; border-bottom: 2px solid transparent;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  .content {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 20px; overflow-y: auto;
  }

  /* Vistas */
  .view { display: none; width: 100%; max-width: 300px; text-align: center; animation: fadeIn 0.3s ease-out; }
  .view.active { display: flex; flex-direction: column; align-items: center; }

  /* Números gigantes */
  .time-display {
    font-size: 56px; font-weight: 700; font-variant-numeric: tabular-nums;
    letter-spacing: -2px; margin-bottom: 8px; line-height: 1;
  }
  .date-display { font-size: 14px; color: var(--muted); font-weight: 500; text-transform: capitalize; }

  /* Botones */
  .btn-group { display: flex; gap: 10px; margin-top: 24px; justify-content: center; }
  .btn {
    background: var(--field); border: 1px solid var(--line); color: var(--text);
    padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px;
    cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .btn:hover { background: var(--line); }
  .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn.primary:hover { filter: brightness(1.1); }
  .btn.danger { color: #ef4444; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Inputs de tiempo */
  .time-inputs { display: flex; gap: 12px; justify-content: center; margin-bottom: 20px; }
  .time-inputs input {
    width: 70px; text-align: center; font-size: 24px; font-weight: 700;
    padding: 10px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--field); color: var(--text); outline: none;
  }
  .time-inputs input:focus { border-color: var(--accent); }

  /* Lista de vueltas */
  .laps-list {
    width: 100%; height: 120px; overflow-y: auto; margin-top: 16px;
    border-top: 1px solid var(--line); padding-top: 8px;
  }
  .lap-item {
    display: flex; justify-content: space-between; padding: 6px 10px;
    font-size: 13px; border-bottom: 1px solid var(--line); color: var(--muted);
  }
  .lap-item span:last-child { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }

  .app-credit {
    text-align: center; font-size: 11px; color: var(--muted); padding: 8px;
    background: var(--card); border-top: 1px solid var(--line); flex-shrink: 0;
  }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }
</style>
</head>
<body>

  <div class="tabs">
    <div class="tab active" data-target="view-clock">Reloj</div>
    <div class="tab" data-target="view-stopwatch">Cronómetro</div>
    <div class="tab" data-target="view-timer">Temporizador</div>
  </div>

  <div class="content">
    <!-- Reloj -->
    <div class="view active" id="view-clock">
      <div class="time-display" id="clock-time">00:00:00</div>
      <div class="date-display" id="clock-date">Cargando...</div>
    </div>

    <!-- Cronómetro -->
    <div class="view" id="view-stopwatch">
      <div class="time-display" id="sw-time">00:00.00</div>
      <div class="btn-group">
        <button class="btn primary" id="sw-start">Iniciar</button>
        <button class="btn" id="sw-lap" disabled>Vuelta</button>
        <button class="btn danger" id="sw-reset">Reiniciar</button>
      </div>
      <div class="laps-list" id="sw-laps"></div>
    </div>

    <!-- Temporizador -->
    <div class="view" id="view-timer">
      <div class="time-inputs">
        <input type="number" id="t-min" min="0" max="99" value="5" placeholder="Min">
        <input type="number" id="t-sec" min="0" max="59" value="0" placeholder="Seg">
      </div>
      <div class="time-display" id="timer-time">05:00</div>
      <div class="btn-group">
        <button class="btn primary" id="t-start">Iniciar</button>
        <button class="btn danger" id="t-reset">Reiniciar</button>
      </div>
    </div>
  </div>

  <div class="app-credit">
    Hecho con ❤️ por VicHeStudios
  </div>

<script>
  // Sincronización de Tema
  if (window.parent !== window) window.parent.postMessage({ type: 'myhub:get-tema' }, '*');
  window.addEventListener('message', (e) => {
    if (e.data?.type === 'myhub:tema:res') {
      document.documentElement.dataset.modo = e.data.modo;
      document.documentElement.style.setProperty('--accent', e.data.color);
      document.documentElement.style.setProperty('--accent-soft', e.data.color + '26');
    }
  });

  // Control de Pestañas
  document.querySelectorAll('.tab').forEach(tab => {
    tab.onclick = () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.target).classList.add('active');
    };
  });

  // Lógica del Reloj
  const updateClock = () => {
    const now = new Date();
    const time = now.toLocaleTimeString('es', { hour12: false });
    const date = now.toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });
    document.getElementById('clock-time').textContent = time;
    document.getElementById('clock-date').textContent = date;
  };
  setInterval(updateClock, 1000);
  updateClock();

  // Lógica del Cronómetro
  let swInterval;
  let swStartTime = 0;
  let swElapsed = 0;
  let isSwRunning = false;
  let lapCount = 1;

  const swTimeEl = document.getElementById('sw-time');
  const swStartBtn = document.getElementById('sw-start');
  const swLapBtn = document.getElementById('sw-lap');
  const swResetBtn = document.getElementById('sw-reset');
  const swLapsEl = document.getElementById('sw-laps');

  const formatSW = (ms) => {
    const min = Math.floor(ms / 60000).toString().padStart(2, '0');
    const sec = Math.floor((ms % 60000) / 1000).toString().padStart(2, '0');
    const cent = Math.floor((ms % 1000) / 10).toString().padStart(2, '0');
    return `${min}:${sec}.${cent}`;
  };

  const updateSW = () => {
    swElapsed = Date.now() - swStartTime;
    swTimeEl.textContent = formatSW(swElapsed);
  };

  swStartBtn.onclick = () => {
    if (isSwRunning) {
      clearInterval(swInterval);
      swStartBtn.textContent = 'Continuar';
      swStartBtn.classList.remove('danger');
      swStartBtn.classList.add('primary');
    } else {
      swStartTime = Date.now() - swElapsed;
      swInterval = setInterval(updateSW, 10);
      swStartBtn.textContent = 'Pausar';
      swStartBtn.classList.remove('primary');
      swStartBtn.classList.add('danger');
    }
    isSwRunning = !isSwRunning;
    swLapBtn.disabled = !isSwRunning && swElapsed === 0;
  };

  swResetBtn.onclick = () => {
    clearInterval(swInterval);
    isSwRunning = false;
    swElapsed = 0;
    swTimeEl.textContent = '00:00.00';
    swStartBtn.textContent = 'Iniciar';
    swStartBtn.classList.remove('danger');
    swStartBtn.classList.add('primary');
    swLapBtn.disabled = true;
    swLapsEl.innerHTML = '';
    lapCount = 1;
  };

  swLapBtn.onclick = () => {
    const lapDiv = document.createElement('div');
    lapDiv.className = 'lap-item';
    lapDiv.innerHTML = `<span>Vuelta ${lapCount}</span><span>${formatSW(swElapsed)}</span>`;
    swLapsEl.prepend(lapDiv);
    lapCount++;
  };

  // Lógica del Temporizador
  let tInterval;
  let tRemaining = 5 * 60; // 5 mins por defecto
  let isTRunning = false;
  
  const tMinInput = document.getElementById('t-min');
  const tSecInput = document.getElementById('t-sec');
  const timerTimeEl = document.getElementById('timer-time');
  const tStartBtn = document.getElementById('t-start');
  const tResetBtn = document.getElementById('t-reset');

  const updateTimerDisplay = () => {
    const m = Math.floor(tRemaining / 60).toString().padStart(2, '0');
    const s = (tRemaining % 60).toString().padStart(2, '0');
    timerTimeEl.textContent = `${m}:${s}`;
  };

  tMinInput.oninput = tSecInput.oninput = () => {
    if (isTRunning) return;
    const m = parseInt(tMinInput.value) || 0;
    const s = parseInt(tSecInput.value) || 0;
    tRemaining = (m * 60) + s;
    updateTimerDisplay();
  };

  tStartBtn.onclick = () => {
    if (isTRunning) {
      clearInterval(tInterval);
      tStartBtn.textContent = 'Continuar';
      tStartBtn.classList.remove('danger');
      tStartBtn.classList.add('primary');
    } else {
      if (tRemaining <= 0) return;
      tStartBtn.textContent = 'Pausar';
      tStartBtn.classList.remove('primary');
      tStartBtn.classList.add('danger');
      
      tInterval = setInterval(() => {
        tRemaining--;
        updateTimerDisplay();
        
        if (tRemaining <= 0) {
          clearInterval(tInterval);
          isTRunning = false;
          tStartBtn.textContent = 'Iniciar';
          tStartBtn.classList.remove('danger');
          tStartBtn.classList.add('primary');
          playAlarm();
          alert('¡Tiempo terminado!');
        }
      }, 1000);
    }
    isTRunning = !isTRunning;
  };

  tResetBtn.onclick = () => {
    clearInterval(tInterval);
    isTRunning = false;
    const m = parseInt(tMinInput.value) || 0;
    const s = parseInt(tSecInput.value) || 0;
    tRemaining = (m * 60) + s;
    updateTimerDisplay();
    tStartBtn.textContent = 'Iniciar';
    tStartBtn.classList.remove('danger');
    tStartBtn.classList.add('primary');
  };

  // Sonido de alarma simple con Web Audio API
  const playAlarm = () => {
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const oscillator = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    
    oscillator.type = 'sine';
    oscillator.frequency.setValueAtTime(880, audioCtx.currentTime); // Nota A5
    oscillator.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    
    // Hacer un pitido intermitente
    gainNode.gain.setValueAtTime(0, audioCtx.currentTime);
    gainNode.gain.linearRampToValueAtTime(1, audioCtx.currentTime + 0.1);
    gainNode.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.5);
    
    oscillator.start();
    oscillator.stop(audioCtx.currentTime + 0.5);
  };

  updateTimerDisplay();
</script>
</body>
</html>
